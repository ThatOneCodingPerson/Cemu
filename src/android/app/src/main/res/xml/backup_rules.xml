<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for Android 11 and lower (data_extraction_rules.xml is used on Android 12+).
   See https://developer.android.com/identity/data/autobackup
-->
<full-backup-content>
    <!-- only the app settings; the Cemu folder holds console keys and possibly gigabytes of titles -->
    <include domain="file" path="datastore/" />
    <include domain="sharedpref" path="." />
</full-backup-content>
