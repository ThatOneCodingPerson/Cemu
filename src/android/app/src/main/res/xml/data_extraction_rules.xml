<?xml version="1.0" encoding="utf-8"?><!--
   Android 12+ backup rules. See https://developer.android.com/identity/data/autobackup
-->
<data-extraction-rules>
    <!-- Only the app settings (DataStore) go to the cloud. The Cemu folder (getExternalFilesDir) holds console keys
         (otp.bin, seeprom.bin, keys.txt), accounts and possibly gigabytes of titles; above the 25 MB cloud quota
         the whole backup would be skipped anyway. -->
    <cloud-backup>
        <include domain="file" path="datastore/" />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <!-- device-to-device transfer (setting up a new device of the same user) keeps everything -->
</data-extraction-rules>
